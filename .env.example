# Copy to .env.local. Both optional (local-dev fallbacks apply). No secrets —
# VITE_* values are compiled into the public bundle.

# Discovery "From issuer" presets — comma-separated, first is the default.
VITE_AUTH_SERVERS=http://localhost:3000,https://authlete-as.vercel.app

# Discovery "From resource" presets — comma-separated, first is the default.
VITE_RESOURCE_SERVERS=http://localhost:8090,https://authlete-rs.vercel.app
